{
  "name": "tenzu",
  "version": "3.2.0",
  "schematics": "schematics/collection.json",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/install-chromium.mjs",
    "start": "node ./init-config.js  && ng serve  tenzu --hmr --host 0.0.0.0 --allowed-hosts true",
    "build": "ng build && npm run sentry:sourcemaps",
    "build-schematics": "./node_modules/.bin/tsc -p ./tsconfig.schematics.json",
    "schematics:add-plugins": "schematics ./src/schematics/collection.json:add-plugins --no-dry-run",
    "schematics:reset-plugins": "schematics ./src/schematics/collection.json:reset-plugins --no-dry-run",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng --no-watch --code-coverage",
    "test:watch": "ng test  --watch",
    "test:cross-browser": "playwright install firefox && ng test --no-watch --configuration cross-browser",
    "test:openapi-check": "vitest run --config scripts/openapi-check/vitest.config.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "openapi:check": "tsx scripts/openapi-check/openapi-check.mts",
    "e2e:ui": "npx playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "transloco:optimize": "transloco-optimize dist/tenzu/browser/assets/i18n",
    "build:staging": "ng build --configuration staging && npm run transloco:optimize",
    "build:production": "ng build --configuration production && npm run transloco:optimize",
    "serve-prod-local": "npx http-server dist/tenzu/browser -p 4200",
    "storybook": "ng run tenzu:storybook",
    "build-storybook": "ng run tenzu:build-storybook",
    "check:design-doc": "node scripts/check-design-doc.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@auth0/angular-jwt": "^5.2.0",
    "@blocknote/code-block": "^0.55.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@jsverse/transloco": "^8.1.0",
    "@jsverse/transloco-locale": "^8.2.0",
    "@jsverse/transloco-messageformat": "^8.2.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/utils": "^6.0.22",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@sentry/angular": "^10.34.0",
    "@y/y": "^14.0.0-16",
    "file-saver-es": "^2.0.5",
    "idb": "^8.0.3",
    "marked": "^18.0.5",
    "ng-event-bus": "^10.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "tus-js-client": "^4.3.1",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-architects/ngrx-toolkit": "^22.0.0",
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular-devkit/schematics-cli": "^22.2.2",
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@apidevtools/json-schema-ref-parser": "^15.5.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-optimize": "^8.4.0",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.5.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular-vite": "^10.6.1",
    "@types/eslint__js": "^9.14.0",
    "@types/file-saver-es": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitest/browser-playwright": "^5.0.4",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.6.1",
    "http-serve": "^1.0.1",
    "jiti": "^2.6.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.64.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "^5.0.4"
  }
}
